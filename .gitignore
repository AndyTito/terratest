# ==========================================
# Terraform / Infraestructura
# ==========================================
# Directorio local de proveedores y plugins
**/.terraform/
.terraform/

# Archivos de estado de Terraform (contienen secretos y estado de la nube)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Archivos de variables con valores reales y credenciales
*.tfvars
*.tfvars.json

# Pero SÍ permitir compartir los archivos de ejemplo en Git
!*.tfvars.example

# Archivos de depuración y overrides de Terraform
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

